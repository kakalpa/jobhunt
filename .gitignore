# ==============================================================================
# Git Ignore Rules for Job Hunt Command Center
# Strictly excludes all secrets, PII, personal CVs, tracking DBs, and generated files
# ==============================================================================

# 1. Secrets & Environment
.env
.env.*
!.env.example
auth_config.json
auth_config.*.json

# 2. Personal & Sensitive Master Profiles (PII)
Base_CV.md*
!Base_CV.template.md
General_CV.md
cover_letter.md
summary_response.md
Verda*
NestAI*

# 3. Personal Tracker & Operational State Files
APPLICATIONS_TRACKER.md
pipeline_data.json
!pipeline_data.template.json
telegram_sent_jobs.json
scout_latest_report.json
JOB_SCOUT_FEED.md
entry_level_scouted.csv

# 4. Generated Artifacts & Documents
*.pdf
workspace/

# 5. Local Dev & System Caches
.pytest_cache/
*.log
*.lock
.scout.lock
.DS_Store
.vscode/
.idea/
.claude/
gpu_sleep_diag/
Hunt/

