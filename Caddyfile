# Redirect direct IP access to the secure HTTPS domain
http://82.70.59.174 {
    redir https://{$DOMAIN_NAME:job.kalpa.eu.cc}{uri} permanent
}

# Secure domain with automated Let's Encrypt / ZeroSSL TLS certificates
{$DOMAIN_NAME:job.kalpa.eu.cc} {
    reverse_proxy job-hunt-command-center:5500 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    # High-performance compression
    encode gzip zstd

    # Strict security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Real-time request logging to stdout
    log {
        output stdout
        format console
    }
}
