# ==============================================================================
# Job Hunt Command Center - Environment Configuration Template
# Copy this file to .env and configure your desired settings:
#   cp .env.example .env
# ==============================================================================

# --- Domain & Reverse Proxy (Caddy) ---
# Set your registered is-a.dev subdomain (e.g. DOMAIN_NAME=jobhunt.is-a.dev)
# Caddy will automatically provision and renew a free Let's Encrypt SSL certificate!
# If left as :80, Caddy operates in HTTP mode without SSL.
DOMAIN_NAME=:80

# --- Security & Authentication ---
# Set AUTH_ENABLED=true for public internet deployments
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
MFA_ENABLED=false
SECRET_KEY=generate_a_random_32_byte_hex_string_here

# --- AI Tailoring & Cover Letter Generation ---
# Free Google AI Studio API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# --- Telegram Real-Time Notifications ---
# Create a bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_MATCH_SCORE=80

# --- Autonomous Job Scout Daemon ---
SCOUT_ENABLED=true
SCOUT_INTERVAL_HOURS=2
SCOUT_RUN_ON_START=false
# Optional: customize search terms (comma-separated). Leave empty for defaults.
SCOUT_QUERIES=Junior IT,Junior Security,IT Specialist,Cybersecurity,IT Trainee
SCOUT_LOCATION=Finland
SCOUT_LOOKBACK_HOURS=168
SCOUT_LIMIT_PER_QUERY=10

# --- Storage & Package Retention Policy ---
POSTING_RETENTION_DAYS=30
RETENTION_PROTECT_STATUS=interviewing,offer,applied
RETENTION_MODE=full
RETENTION_NOTIFY_TELEGRAM=true

# --- Application Server ---
PORT=5500
GUNICORN_WORKERS=4
