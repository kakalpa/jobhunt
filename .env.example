# ==============================================================================
# Security, Authentication & Multi-Factor Auth (Required for Public Servers)
# ==============================================================================
AUTH_ENABLED=true
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeThisToAStrongSecretPassword"
MFA_ENABLED=true
SECRET_KEY="generate-random-32-byte-hex-secret-here"

# Google Gemini API Key for AI tailoring & interview prep generation
GEMINI_API_KEY="your-gemini-api-key-here"

# Telegram Bot Integration for instant scout & pipeline alerts
# 1. Message @BotFather on Telegram to get your bot token
# 2. Start the bot and message @userinfobot to get your numeric Chat ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_MIN_MATCH_SCORE=80

# Autonomous Scout Daemon (Runs in background inside Docker)
SCOUT_ENABLED=true
SCOUT_INTERVAL_HOURS=2
SCOUT_RUN_ON_START=false

# Dashboard Server Port
PORT=5500

# Storage Retention & Automated Disk Cleanup
# Delete inactive/expired postings older than N days (0 disables auto-cleanup)
POSTING_RETENTION_DAYS=30
# Statuses permanently protected from cleanup (comma-separated)
RETENTION_PROTECT_STATUS="interviewing,offer,applied"
# Cleanup Mode: 'full' (deletes entire folder) or 'pdfs_only' (purges PDFs, keeps markdown)
RETENTION_MODE="full"
# Send summary alert to Telegram when cleanup reclaims space
RETENTION_NOTIFY_TELEGRAM=true

